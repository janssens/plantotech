<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block meta_description %}Base de donnée de plantes permacoles{% endblock %}" />
        <meta name="author" content="Gaetan Janssens" />
        {% block head %}{% endblock %}
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans&display=swap" rel="stylesheet">        
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        
    </head>
    <body>
        <header class="bg-(--color-bg-two)">
            <div class="container-center mx-auto w-full md:w-5/6 lg:1/2">
                <a href="https://alveoles.fr" title="Site des alvéoles" class="block md:hidden h-20 mr-8 text-center">
                    <img class="fit-contain max-h-full inline" src="{{ asset('build/img/logo_alveoles.png') }}" alt="logo les alvéoles">
                </a>
                <nav class="pb-8 md:pb-2">
                    <ul class="list-none flex flex-wrap justify-center gap-4 items-center text-(--color-head)">
                        <li class="hidden md:block lg:w-auto w-full text-center"><a href="https://alveoles.fr" title="Site des alvéoles" class="h-20 mr-8 hover:text-black p-4 md:p-0"><img class="fit-contain max-h-full" src="{{ asset('build/img/logo_alveoles.png') }}" alt="logo les alvéoles"></a></li>
                        <li class=""><a class=" hover:text-black p-4 md:p-0" href="https://alveoles.fr/event">Agenda</a></li>
                        <li class=""><a class=" hover:text-black p-4 md:p-0" href="https://alveoles.fr/catalogue-de-formations">Formations</a></li>
                        <li class=""><a class=" hover:text-black p-4 md:p-0" href="https://alveoles.fr/permatheque">Permathèque</a></li>
                        <li class=""><a class=" hover:text-black p-4 md:p-0" href="https://alveoles.fr/pepiniere">Pépinière</a></li>
                        <li class=""><a class=" hover:text-black p-4 md:p-0" href="https://alveoles.fr/atelier">Bureau d'étude</a></li>
                        <li class=""><a class=" hover:text-black p-4 md:p-0" href="https://alveoles.fr/la-ruche">Auberge</a></li>
                    </ul>
                </nav>
            </div>
        </header>
        <div class="text-center bg-(--color-green_one) py-8 text-white uppercase font-sans">
            {{ mdi('home-outline','fill-white inline') }} <a class="inline-block hover:underline" href="{{ base_url }}">Accueil base plantes </a> | {{ mdi('list-box','fill-white inline') }} <a class="inline-block hover:underline" href="{{ path('plant_index') }}">liste des plantes</a>
        </div>
        <div class="container-center min-h-screen mx-auto w-full md:w-5/6 lg:1/2">
            {% block body %}{% endblock %}
        </div>
        <footer class="h-10 bg-white w-full border-t text-center p-1">
            <small>Un bug 🐛 ? Une suggestion 💡 ? 
                <a class="underline cursor-pointer" ="{{ mailto('contact@plopcom.fr', 'Base plantes des Alvéoles', '') }}"> 
                    Envoyer moi un email </a>! | 
                    {% if is_granted('ROLE_USER') %}
                       <b> {% if is_granted('ROLE_ADMIN') %}🌳{% else %}🧘{% endif %} {{ app.user.username }} </b> | {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}">⚙ admin</a> | {% endif %} <a href="{{ path('app_logout') }}"><i class="mdi mdi-lock-off"></i>déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">admin</a>
                    {% endif %}
        </footer>
        {% if app.session.flashBag.peekAll|length > 0 %}
            <div id="flash" class="px-10 flex flex-col space-y-3 fixed w-full top-14">
                {% for type,messages in app.session.flashBag.all %}
                    {% if type == "info" %}
                        {% for message in messages %}
                            <div class="bg-blue-100 p-5 w-full sm:w-1/2 border-l-4 border-blue-500 relative message">
                                <div class="flex space-x-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="flex-none fill-current text-blue-500 h-4 w-4">
                                        <path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-.001 5.75c.69 0 1.251.56 1.251 1.25s-.561 1.25-1.251 1.25-1.249-.56-1.249-1.25.559-1.25 1.249-1.25zm2.001 12.25h-4v-1c.484-.179 1-.201 1-.735v-4.467c0-.534-.516-.618-1-.797v-1h3v6.265c0 .535.517.558 1 .735v.999z"></path></svg>
                                    <div class="flex-1 leading-tight text-sm text-blue-700">{{ message }}</div>
                                </div>
                                <div class="absolute right-2 top-1 cursor-pointer close">
                                    <i class="mdi mdi-close"></i>
                                </div>
                            </div>
                        {% endfor %}
                    {% elseif type == "success" %}
                        {% for message in messages %}
                            <div class="bg-green-100 p-5 w-full sm:w-1/2 rounded relative message">
                                <div class="flex justify-between">
                                    <div class="flex space-x-3">
                                        <div class="flex-none fill-current text-green-500">
                                            <i class="mdi mdi-checkbox-marked-circle"></i></div>
                                        <div class="flex-1 text-sm text-green-700 font-medium">{{ message }}</div>
                                    </div>
                                    <div class="flex-none fill-current text-green-600 cursor-pointer close">
                                        <i class="mdi mdi-close"></i>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% elseif type == "error" %}
                        {% for message in messages %}
                            <div class="bg-red-100 p-5 w-full sm:w-1/2 relative message">
                                <div class="flex space-x-3">
                                    <i class="mdi mdi-close-circle text-red-700"></i>
                                    <div class="leading-tight flex flex-col space-y-2">
                                        <div class="text-sm font-medium text-red-700">Oups !</div>
                                        <div class="flex-1 leading-snug text-sm text-red-600">{{ message }}</div>
                                    </div>
                                </div>
                                <div class="absolute right-2 top-1 cursor-pointer close">
                                    <i class="mdi mdi-close"></i>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
        {# <a href="#" data-toggle="#menu_mobile" class="fixed -top-10 -left-10 text-2xl text-white rounded-full bg-(--color-green_two) w-20 h-20 block pl-10 pt-10 md:hidden">{{ mdi("menu",'fill-white') }}</a> #}
        {% block javascripts %}
            {# {% block importmap %}{{ importmap('app') }}{% endblock %} #}
                {{ encore_entry_script_tags('app') }}
            {% if config('app/embed') %}
                <script href="{{ asset('embed.js') }}">
            {% endif %}
        {% endblock %}
        {% if config('app/embed') %}
            <script>
                let embed_admin = {% if is_granted('ROLE_ADMIN') %}true{% else %}false{% endif %};
                let embed = true;
                let parent_url = "{{ config('app/parent_url') }}";
            </script>
        {% endif %}
    </body>
</html>